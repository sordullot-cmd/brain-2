# Navigateur ouvert par Vite au démarrage (npm run dev).
#
# Sans cette variable, Vite ne suit pas le navigateur par défaut de macOS : il
# cherche un Chromium de sa liste interne (Google Chrome, Edge, Brave, Vivaldi,
# Chromium) déjà lancé pour y réutiliser un onglet. Arc n'y figure pas, donc le
# site s'ouvrait dans Chrome. Avec BROWSER=Arc, Vite passe par `open -a Arc`.
BROWSER=Arc
