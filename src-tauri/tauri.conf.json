{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "brain^2",
  "version": "1.0.0",
  "identifier": "design.sacha.brain2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run app:vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "brain^2",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "copyright": "Sacha Moricet",
    "category": "Productivity",
    "shortDescription": "Le second cerveau, en app",
    "longDescription": "Navigation visuelle du vault Obsidian : inspirations, univers de référence, composants, animations et notes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
