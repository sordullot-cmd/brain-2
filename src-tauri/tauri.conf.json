{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "brain^2",
  "version": "1.0.0",
  "identifier": "design.sacha.brain2.live",
  "build": {
    "frontendDist": "https://brain-2-cookozmail-7767s-projects.vercel.app",
    "devUrl": "https://brain-2-cookozmail-7767s-projects.vercel.app",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "brain^2",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "copyright": "Sacha Moricet",
    "shortDescription": "Le second cerveau, en fenêtre native",
    "longDescription": "Fenêtre native sur le site brain^2 déployé : le site reste la source de vérité, un déploiement suffit à mettre l'app à jour.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
